def cleanup(n):
    for s in [".a", ".b"]:
        if n + s in listfiles():
            removefile(n + s)

def start_writer(f, holder):
    def run():
        while not holder["stop"]:
            try:
                f.writeat("SaaaE", 0)
                f.writeat("xaaax", 0)
            except Exception:
                pass
    createthread(run)

big = "S" + "x" * 1000 + "E"
attack_succeeded = False

for i in range(5):
    cleanup("ac9")
    try:
        f = ABopenfile("ac9", True)
        f.writeat(big, 0)
        f.close()

        f = ABopenfile("ac9", False)
        holder = {"stop": False}
        start_writer(f, holder)
        sleep(0.01)
        f.close()
        holder["stop"] = True

        g = ABopenfile("ac9", False)
        got = g.readat(10000, 0)
        g.close()

        if got[0:1] != "S" or got[-1:] != "E":
            attack_succeeded = True
            break
    except Exception:
        pass

if attack_succeeded:
    log("ATTACK SUCCEEDED: Thread race allowed invalid data into valid file\n")

cleanup("ac9")