def cleanup(n):
    for s in [".a", ".b"]:
        if n + s in listfiles():
            removefile(n + s)

cleanup("ac5a")
cleanup("ac5b")
attack_succeeded = False

try:
    f1 = ABopenfile("ac5a", True)
    f2 = ABopenfile("ac5b", True)
    f1.writeat("SoneE", 0)
    f2.writeat("xtwox", 0)
    f2.close()
    f1.close()

    g1 = ABopenfile("ac5a", False)
    g2 = ABopenfile("ac5b", False)
    a = g1.readat(100, 0)
    b = g2.readat(100, 0)
    g1.close()
    g2.close()

    if a != "SoneE" or b != "SE":
        attack_succeeded = True
except Exception:
    pass

if attack_succeeded:
    log("ATTACK SUCCEEDED: State shared between open files\n")

cleanup("ac5a")
cleanup("ac5b")